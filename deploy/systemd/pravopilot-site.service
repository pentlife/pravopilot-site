[Unit]
Description=Pravopilot Next.js website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botapp
Group=botapp
WorkingDirectory=/home/botapp/apps/pravopilot-site
EnvironmentFile=-/home/botapp/apps/pravopilot-site/.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/botapp/apps/pravopilot-site

[Install]
WantedBy=multi-user.target
